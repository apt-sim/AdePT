# These macros stop before /run/initialize: command validation needs neither a field map nor a GPU.
function(check_field_commands name expected_error commands)
  set(macro "${CMAKE_CURRENT_BINARY_DIR}/${name}.mac")
  file(WRITE "${macro}" "${commands}\n/control/echo FIELD_COMMANDS_ACCEPTED\n")
  execute_process(COMMAND "${APPLICATION}" -m "${macro}"
    OUTPUT_VARIABLE output ERROR_VARIABLE error RESULT_VARIABLE result TIMEOUT 30)
  string(APPEND output "${error}")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${name}.log" "${output}")
  if(expected_error STREQUAL "")
    if(NOT result STREQUAL "0" OR NOT output MATCHES "FIELD_COMMANDS_ACCEPTED")
      message(FATAL_ERROR "${name}: supported commands failed (${result}):\n${output}")
    endif()
  else()
    if(result STREQUAL "0" OR NOT output MATCHES "${expected_error}" OR output MATCHES "FIELD_COMMANDS_ACCEPTED")
      message(FATAL_ERROR "${name}: expected command rejection '${expected_error}' (${result}):\n${output}")
    endif()
  endif()
  message(STATUS "${name}: passed")
endfunction()

set(uniform "/detector/setField 0 0 1 tesla")
set(zero "/detector/setField 0 0 0 tesla")
set(detector_map "/detector/setCovfieBfieldFile unused.cvf")
set(adept_map "/adept/setCovfieBfieldFile unused.cvf")
check_field_commands(no_field "" "# No field commands")
if(EXT_BFIELD)
  set(error "/detector/setField requires ADEPT_USE_EXT_BFIELD=OFF")
  check_field_commands(uniform "${error}" "${uniform}")
  check_field_commands(zero "${error}" "${zero}")
  check_field_commands(map_then_uniform "${error}" "${detector_map}\n${adept_map}\n${uniform}")
  check_field_commands(uniform_then_map "${error}" "${uniform}\n${detector_map}\n${adept_map}")
  check_field_commands(map_then_zero "${error}" "${detector_map}\n${zero}")
  check_field_commands(detector_map "" "${detector_map}")
  check_field_commands(adept_map "" "${adept_map}")
  check_field_commands(both_maps "" "${detector_map}\n${adept_map}")
else()
  set(detector_error "/detector/setCovfieBfieldFile requires ADEPT_USE_EXT_BFIELD=ON")
  set(adept_error "/adept/setCovfieBfieldFile requires ADEPT_USE_EXT_BFIELD=ON")
  check_field_commands(detector_map "${detector_error}" "${detector_map}")
  check_field_commands(adept_map "${adept_error}" "${adept_map}")
  check_field_commands(uniform_then_detector_map "${detector_error}" "${uniform}\n${detector_map}")
  check_field_commands(uniform_then_adept_map "${adept_error}" "${uniform}\n${adept_map}")
  check_field_commands(detector_map_then_uniform "${detector_error}" "${detector_map}\n${uniform}")
  check_field_commands(adept_map_then_uniform "${adept_error}" "${adept_map}\n${uniform}")
  check_field_commands(uniform "" "${uniform}")
  check_field_commands(zero "" "${zero}")
endif()
